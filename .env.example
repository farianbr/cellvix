# ---- server ----
NODE_ENV=development
PORT=4000

# MongoDB connection string. REQUIRED — there is no in-memory fallback.
# An empty or malformed value stops the server at boot with a named error.
# Prefer a replica set (any Atlas cluster is one): order creation needs transactions.
# Use a SEPARATE database for the test scripts — smoke, shoot and a11y all write:
#   MONGODB_URI="<uri>/cellvix_test" npm run seed
# Local:  mongodb://127.0.0.1:27017/cellvix
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cellvix
MONGODB_URI=

# Sign the auth cookie. Any long random string. REQUIRED in production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Encrypts provider credentials saved on Settings > API Keys (AES-256-GCM).
# Optional: left empty, the key is derived from JWT_SECRET through scrypt.
#
# WARNING: changing this — or JWT_SECRET while this is empty — makes every
# stored credential undecryptable. That is deliberate: the affected provider
# then reports itself unconfigured and the keys must be re-entered, which is
# far safer than a key that decrypts to garbage and gets sent to a provider.
SECRETS_KEY=
JWT_EXPIRES_IN=7d
COOKIE_NAME=cellvix_session

# Comma-separated origins allowed to send credentialed requests
CLIENT_ORIGIN=http://localhost:5173

# ---- outbound mail (optional) ----
# The invoice is emailed to the buyer the moment an order is placed. With no
# SMTP_URL the mailer writes each message to server/.mail/ and logs it instead
# of sending — the order completes either way, so an unconfigured mail host can
# never fail a checkout. Real delivery also needs `npm i nodemailer -w server`.
#   SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Cellvix <billing@cellvix.ca>
# Where links in an email point. Defaults to the first CLIENT_ORIGIN.
PUBLIC_ORIGIN=

# Makes the MOCK payment gateway decline every charge, so /payment-failed can be
# exercised end to end. Leave false: a single order can be declined on demand by
# giving it a PO number that starts with DECLINE.
MOCK_PAYMENT_DECLINE=false

# ---- client (Vite: must be VITE_ prefixed) ----
VITE_API_URL=/api
